{
  "name": "@convert-tools/core",
  "version": "3.0.0",
  "description": "Dependency-free exact length, coordinate conversion and WGS84 geodesy core",
  "keywords": [
    "unit-conversion",
    "length-conversion",
    "wgs84",
    "geodesy",
    "mgrs",
    "utm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mertc0604/convert-tools.git",
    "directory": "packages/core-js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./units": {
      "import": "./src/units/index.js",
      "require": "./dist/cjs/units/index.js"
    },
    "./length": {
      "import": "./src/units/index.js",
      "require": "./dist/cjs/units/index.js"
    },
    "./geodesy": {
      "import": "./src/geodesy/index.js",
      "require": "./dist/cjs/geodesy/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/cjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-cjs.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7"
  }
}
