{
  "name": "convert-tools",
  "version": "3.0.0",
  "description": "Kesin uzunluk ve koordinat dönüşüm kütüphanesi (JS + Java) ve tanıtım uygulaması",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core-js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:core": "npm run build --workspace @convert-tools/core",
    "test:core": "npm test --workspace @convert-tools/core",
    "test:pack": "npm run test:pack --workspace @convert-tools/core",
    "test:java": "sh packages/core-java/scripts/test.sh",
    "vectors": "node contracts/tools/generate-vectors.mjs"
  }
}
