{
  "name": "convert-tools",
  "version": "1.0.0",
  "description": "Kesin uzunluk ve koordinat dönüşüm kütüphanesi (JS + Java)",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core-js"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "npm run build --workspace @omcoskun/convert-tools",
    "test:core": "npm test --workspace @omcoskun/convert-tools",
    "test:pack": "npm run test:pack --workspace @omcoskun/convert-tools",
    "test:java": "sh packages/core-java/scripts/test.sh",
    "test:tools": "node --test \"contracts/tools/test/*.test.mjs\"",
    "vectors": "node contracts/tools/generate-vectors.mjs",
    "test": "npm run test:core",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "9.39.5"
  }
}
